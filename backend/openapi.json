{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Health status of the service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "example": "csmju-intern-sync"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "AuthController_login",
        "parameters": [
          {
            "name": "next",
            "required": false,
            "in": "query",
            "description": "Local path to redirect to after sign-in",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to Core Hub SSO"
          },
          "503": {
            "description": "Authentication is unavailable"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "AuthController_callback",
        "parameters": [
          {
            "name": "state",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "access_token",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Sets the verified session cookie and redirects to the local path"
          },
          "400": {
            "description": "Missing access token"
          },
          "401": {
            "description": "Invalid state or access token"
          },
          "403": {
            "description": "The account role is not allowed"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "303": {
            "description": "Clears subsystem cookies and redirects to Core Hub logout"
          },
          "503": {
            "description": "Core Hub URL is unavailable"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "MeController_me_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns the authenticated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "email",
                        "name",
                        "role",
                        "studentId"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "The user sub from the verified Core Hub token"
                        },
                        "email": {
                          "type": "string",
                          "nullable": true
                        },
                        "name": {
                          "type": "string",
                          "nullable": true
                        },
                        "role": {
                          "type": "string"
                        },
                        "studentId": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required"
          },
          "403": {
            "description": "The account role is not allowed"
          },
          "503": {
            "description": "Core Hub profile data is unavailable"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "info": {
    "title": "InternSync API",
    "description": "API contract for csmju-intern-sync",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {}
  }
}
